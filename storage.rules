rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // アバター画像: 認証済みユーザーが自分のパスに読み書き可
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // デフォルト: 全アクセス拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
