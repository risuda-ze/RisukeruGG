# ローカル開発用の環境変数。`.env.local` にコピーして使う。
# このままの値で Firebase Emulator（pnpm emulators）に接続して動作する。秘密値は書き込まない。

# --- Firebase Emulator 接続 ---
NEXT_PUBLIC_USE_EMULATORS=true
# ブラウザが接続するエミュレータのホスト（未設定は localhost）
NEXT_PUBLIC_EMULATOR_HOST=localhost
# Admin SDK（Next.js の API ルート）をエミュレータに向ける
FIREBASE_AUTH_EMULATOR_HOST=localhost:9098
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Firebase クライアント設定 ---
# エミュレータではダミー値でよい。プロジェクト ID は demo-risukeru に合わせる
# （pnpm emulators と scripts/seed.mjs が同じ ID を使う）。
# 実プロジェクトに接続する場合は Firebase Console > プロジェクト設定 > マイアプリ の値に置き換え、
# 上のエミュレータ接続の行を削除する。
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-risukeru.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-risukeru
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-risukeru.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
# GA4 計測 ID。設定時のみ Analytics を有効化（エミュレータ利用時は常に無効）
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- 任意: アプリの URL ---
# 未設定は https://risukeru.gg。Discord 連携の戻り先は NEXTAUTH_URL（未設定はリクエストの origin）
# 空のまま有効にすると空文字になりフォールバックが効かないため、使うときだけ値を入れて有効にする
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# --- 任意: 運用フラグ（README の「環境変数」参照）---
NEXT_PUBLIC_FREE_PARTY_MODE=
NEXT_PUBLIC_CLOSED_BETA=

# --- 任意: Discord Bot 連携（Developer Portal > アプリ から取得）---
# 未設定でも画面は動く。Discord 連携を試すときだけ設定する
DISCORD_CLIENT_ID=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# ギルドコマンド登録 API（/api/discord/register-guild-commands）の呼び出し認証
INTERNAL_API_SECRET=

# --- 任意: AI 機能 ---
ANTHROPIC_API_KEY=

# --- 任意: エラー監視（README の「エラー監視・アナリティクス」参照）---
NEXT_PUBLIC_SENTRY_DSN=

# --- 任意: 管理スクリプト（scripts/beta-allowlist.mjs など）---
# サービスアカウント JSON（1 行の文字列）。Next.js の Admin SDK は
# FIREBASE_AUTH_EMULATOR_HOST が無いときにこれで実プロジェクトへ接続する
FIREBASE_SERVICE_ACCOUNT_KEY=
