    "@vercel/functions": "^3.6.1",
    "ai": "^6.0.287",
    "date-fns": "^4.1.0",
    "discord-interactions": "^4.4.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
