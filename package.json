  "private": true,
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "dev": "next dev",
    "functions:build": "pnpm --dir functions build",
    "build": "next build",
    "start": "next start",
    "cleanup:discord-invite-temp": "node scripts/cleanup-discord-invite-temp.mjs",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
