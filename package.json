    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:emulator": "playwright test --project=emulator --workers=1",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
