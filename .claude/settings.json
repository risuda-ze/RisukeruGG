{
  "extraKnownMarketplaces": {
    "risukeru": {
      "source": {
        "source": "directory",
        "path": "./.agents"
      }
    }
  },
  "enabledPlugins": {
    "risukeru-agents@risukeru": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm check:static)",
      "Bash(node scripts/agent/*)",
      "PowerShell(pnpm verify)",
      "PowerShell(node scripts/agent/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.docker)",
      "Read(./service-account.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.env.docker)",
      "Edit(./service-account.json)"
    ]
  }
}
