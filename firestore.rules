// Firestore Security Rules
//
// デプロイ手順:
//   firebase deploy --only firestore:rules
//
// ローカル確認:
//   firebase firestore:rules:validate
//
// Discord 関連ルール（2026-05-30 更新）:
//   - /discord_sessions/{guildId}            — Admin SDK のみ（クライアント不可）
//   - /discord_bot_invite_requests/{nonce}   — Admin SDK のみ（Bot 招待 CSRF 保護用）
//   - /discord_bot_invite_pending/{nonce}    — Admin SDK のみ（チャンネル一覧一時保存用）
//   - /teams/{teamId}/discord/{doc}          — operator のみ読み書き可

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── クローズドベータ入場制限（T11） ─────────────────────────
    // ゲートの正は Firestore。環境変数はルールから参照できないため、
    //   app_config/beta { enabled: bool }  … ゲートの有効/無効
    //   beta_allowlist/{email}             … 許可ユーザー（ID = 小文字正規化メール）
    // を get()/exists() で参照して判定する。
    // get() 呼び出しは関数化して共通化し、1 評価内でキャッシュされる同一ドキュメント
    // 参照に留めることで課金・上限（1リクエストあたり get/exists 数）への影響を抑える。

    // ベータゲートが現在アクティブか（doc 未作成 or enabled=false のときは非アクティブ）
    function betaGateActive() {
      return exists(/databases/$(database)/documents/app_config/beta) &&
             get(/databases/$(database)/documents/app_config/beta).data.enabled == true;
    }

    // 認証ユーザーのメールが allowlist に在籍しているか（ID = 小文字正規化メール）
    function isBetaAllowed() {
      return request.auth != null &&
             request.auth.token.email != null &&
             exists(/databases/$(database)/documents/beta_allowlist/$(request.auth.token.email.lower()));
    }

    // ベータゲートを通過できるか（非アクティブなら全員通過、アクティブなら allowlist 在籍のみ）
    function passesBetaGate() {
      return !betaGateActive() || isBetaAllowed();
    }

    // 自分のメールと一致する allowlist ドキュメント ID か（get 限定の在籍確認用）
    function isOwnAllowlistDoc(docEmail) {
      return request.auth != null &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == docEmail &&
             // email/password ユーザーは検証済みメールのみ許可（Google は常に検証済み）
             (request.auth.token.firebase.sign_in_provider != 'password' ||
              request.auth.token.email_verified == true);
    }

    // クローズドベータ許可リスト。
    // - list は全面拒否（列挙・推測確認を防止）
    // - get は自分のメールと一致する ID のみ許可
    // - write は Admin SDK（管理スクリプト）のみ
    match /beta_allowlist/{email} {
      allow get: if isOwnAllowlistDoc(email);
      allow list: if false;
      allow write: if false;
    }

    // ベータゲートフラグ。クライアントは NEXT_PUBLIC_CLOSED_BETA で表示切替するため
    // クライアントからの直接読み書きは不要（rules 内の get() は本ルールの影響を受けない）。
    match /app_config/{configId} {
      allow read, write: if false;
    }

    // ベータ利用申請の記録。書き込みは Callable Function（Admin SDK）経由のみ。
    match /beta_requests/{uid} {
      allow read, write: if false;
    }

    function isTeamMember(teamId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) &&
             // クローズドベータ期間中は allowlist 在籍を必須にする（未在籍はデータアクセス不可）
             passesBetaGate();
    }

    function isTeamOwner(teamId) {
      return isTeamMember(teamId) &&
             get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'operator';
    }

    function isOwnerOrEditor(teamId) {
      return isTeamMember(teamId) &&
             get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['operator', 'member'];
    }

    // ユーザードキュメント（自分のみ読み書き）
    // plan / planUpdatedAt / stripeCustomerId はサーバー（Stripe Webhook / Admin SDK）専用フィールド。
    // クライアントからの書き換えを禁止し、課金状態の不正操作を防ぐ（T4 / PL-009）。
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // 作成は onUserCreate（Admin SDK）、削除は deleteAccount（Admin SDK）のみが行う。
      // クライアントに create/delete を許すと「削除→plan:'party' で再作成」による
      // 課金バイパスが可能になるため禁止する（T4 / PL-009）。
      allow create, delete: if false;
      allow update: if request.auth != null && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['plan', 'planUpdatedAt', 'stripeCustomerId']);
    }

    // チームコード（認証済みユーザーが読み取り可、書き込みはCloud Functionsのみ）
    match /teamCodes/{code} {
      allow read: if request.auth != null && passesBetaGate();
      allow write: if false;
    }

    // Discord AI ボットのセッション管理 — Admin SDK（Cloud Functions/API Route）のみ
    // クライアントからの直接アクセスは一切不可
    match /discord_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Discord Bot 招待 CSRF 保護用ノンス — Admin SDK のみ。クライアント不可（使い捨て）
    match /discord_bot_invite_requests/{nonce} {
      allow read, write: if false;
    }

    // Discord Bot 招待フロー用チャンネル一覧一時保存 — Admin SDK のみ
    match /discord_bot_invite_pending/{nonce} {
      allow read, write: if false;
    }

    // タスク管理 v2 の工程をチーム横断で読むために必要
    // （subscribeTeamSteps が collectionGroup('steps') を teamId で絞って使用する）
    // write は /teams/{teamId}/briefs/{briefId}/steps/{stepId} のネストルールが担保する
    match /{path=**}/steps/{stepId} {
      allow read: if request.auth != null && isTeamMember(resource.data.teamId);
    }

    match /teams/{teamId} {
      allow read: if isTeamMember(teamId);
      allow create: if request.auth != null && passesBetaGate();
      allow update, delete: if isTeamOwner(teamId);

      match /members/{memberId} {
        allow read: if isTeamMember(teamId);
        // 参加・退出・Kick は Callable Function（Admin SDK）経由のみ。
        // クライアントからの作成を許すと、teamId を知る第三者が任意の role で自分を追加できる。
        allow create, delete: if false;
        // クライアントが書けるのは表示用プロフィールと Discord 名（TE-012）だけ。
        // role（ロール変更は updateMemberRole）と plan（T4 / PL-009）はサーバーのみが書く。
        // 許可リスト方式にして、本人が自分の role を operator に書き換える昇格を防ぐ。
        allow update: if (isTeamOwner(teamId) ||
                        (isTeamMember(teamId) && request.auth.uid == memberId)) &&
                        request.resource.data.diff(resource.data)
                           .affectedKeys()
                           .hasOnly(['displayName', 'avatarUrl', 'discordUsername', 'discordUserId']);
      }

      match /taskStatuses/{columnId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamOwner(teamId);
      }

      // タスク・スケジュール共通の統合カテゴリ。編集は operator のみ。
      match /categories/{categoryId} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamOwner(teamId);
      }

      match /schedules/{scheduleId} {
        allow read: if isTeamMember(teamId);
        allow write: if isOwnerOrEditor(teamId);
      }

      match /tasks/{taskId} {
        allow read: if isTeamMember(teamId);
        allow update, delete: if isOwnerOrEditor(teamId);
        allow create: if false;
      }

      match /collabSessions/{sessionId} {
        // URLトークン（UUID v4）が事実上の認証となるため公開読み取りOK
        allow read: if true;
        allow update, delete: if isOwnerOrEditor(teamId);
        // 新規作成は Cloud Function (Admin SDK) 経由のみ。クライアント直接作成は不可。
        allow create: if false;
      }

      // Discord 通知設定 — operator のみ読み書き可
      // Webhook URL をチームメンバーから隠すためサブコレクション方式を採用
      match /discord/{doc} {
        allow read, write: if isTeamOwner(teamId);
      }

      // AI 設定（追加指示・定型指示）— 閲覧はメンバー、編集は operator（AI-022 / AI-023）
      match /ai/{doc} {
        allow read: if isTeamMember(teamId);
        allow write: if isTeamOwner(teamId);
      }

      // ── タスク管理 v2（1枚紙） ─────────────────────────────
      // 進め方（工程の型）。閲覧は全メンバー、編集は operator / member
      match /playbooks/{playbookId} {
        allow read: if isTeamMember(teamId);
        allow write: if isOwnerOrEditor(teamId);
      }

      // ブリーフ（動画1本）。書き込みは操作層（writeBatch）経由
      match /briefs/{briefId} {
        allow read: if isTeamMember(teamId);
        allow write: if isOwnerOrEditor(teamId);

        // 工程。コレクショングループ読み取りは下の /{path=**}/steps ルールが担う
        match /steps/{stepId} {
          allow read: if isTeamMember(teamId);
          allow write: if isOwnerOrEditor(teamId);

          // 工程のやり取り
          match /comments/{commentId} {
            allow read: if isTeamMember(teamId);
            allow create: if isOwnerOrEditor(teamId);
            allow update, delete: if isTeamOwner(teamId) ||
                                    (isOwnerOrEditor(teamId) && resource.data.authorId == request.auth.uid);
          }
        }

        // 差分（追記のみ。改変・削除は不可）
        match /briefEvents/{eventId} {
          allow read: if isTeamMember(teamId);
          allow create: if isOwnerOrEditor(teamId);
          allow update, delete: if false;
        }
      }

    }
  }
}
